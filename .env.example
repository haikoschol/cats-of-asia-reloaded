# Local database settings. Keep the real password and DATABASE_URL server-side.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cats
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?sslmode=disable

# Public image-delivery settings. Domain is a hostname, without https:// or a path.
# These example values do not point to real images. Optional until images are used.
CLOUDFLARE_IMAGES_DOMAIN=images.example.com
CLOUDFLARE_IMAGES_ACCOUNT_HASH=example-account-hash

# Public browser token for the future map. This is a dummy, not a working token.
# Optional until the map is used. Do not use a private Mapbox token here.
MAPBOX_ACCESS_TOKEN=example-public-map-token

# Future server-only settings; not read or required by the current Go app.
# Never expose these values in HTML, JavaScript, JSON responses, or logs.
# CLOUDFLARE_IMAGES_ACCOUNT_ID=
# CLOUDFLARE_IMAGES_API_KEY=
# GOOGLE_MAPS_API_KEY=
# MASTODON_ACCESS_TOKEN=
