# Local users/session database settings for Docker Compose and pgconsole.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cats

# Both URLs are required. Content uses the existing photo schema.
# Uploads need write permissions on the photo tables and their identity sequences.
# Replace this example with the connection supplied by the database owner.
DATABASE_URL=postgres://reader:example-password@db.example.com/photos?sslmode=require
# Must match the local Docker credentials above. URL-encode special characters.
USERS_DATABASE_URL=postgres://app:change-me@localhost:5432/cats?sslmode=disable

# Local HTTP: false (default). Set true for HTTPS production, including Caddy.
HTTP_LISTEN_ADDR=:3000
SESSION_COOKIE_SECURE=false

# Optional Plausible analytics. Disabled by default for local development.
# The tracked site must be added separately in the existing Plausible dashboard.
PLAUSIBLE_ENABLED=false
PLAUSIBLE_DOMAIN=reloaded.catsof.asia
PLAUSIBLE_SCRIPT_URL=https://analytics.catsof.asia/js/script.js

# Public image-delivery settings. Domain is a hostname, without https:// or a path.
# These example values do not point to real images. Optional until images are used.
CLOUDFLARE_IMAGES_DOMAIN=images.example.com
CLOUDFLARE_IMAGES_ACCOUNT_HASH=example-account-hash

# Public browser token for the future map. This is a dummy, not a working token.
# Optional until the map is used. Do not use a private Mapbox token here.
MAPBOX_ACCESS_TOKEN=pk.example-public-map-token

# Optional server-only Google Geocoding client. Keep disabled until credentials
# and possible costs are agreed. Never expose the key to the browser or logs.
GOOGLE_GEOCODING_ENABLED=false
# GOOGLE_MAPS_API_KEY=

# Optional server-only Cloudflare upload settings. The API key is a scoped
# Images API token with Images Write permission, not a Global API Key.
# Required only when requesting upload URLs; keep private and out of logs.
# CLOUDFLARE_IMAGES_ACCOUNT_ID=
# CLOUDFLARE_IMAGES_API_KEY=

# Future server-only setting; not read by the current Go app.
# MASTODON_ACCESS_TOKEN=
