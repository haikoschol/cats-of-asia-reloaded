<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Cats of Asia</title>

  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background: #050505;
      color: #00ff41;
      font-family: "Courier New", monospace;
    }

    .site-header {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
      padding: 1rem;
      border-bottom: 1px solid #008f11;
    }

    .site-name {
      color: inherit;
      font-size: 1.25rem;
      font-weight: bold;
      text-decoration: none;
    }

    .place-picker {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem;
      max-width: 100%;
    }

    select {
      max-width: 100%;
      padding: 0.5rem;
      font: inherit;
      background: #050505;
      color: inherit;
      border: 1px solid #008f11;
    }

    main {
      flex: 1;
      display: grid;
      place-items: center;
      padding: 1rem;
    }

    .selected-place {
      margin: 0;
      padding: 1rem;
    }

    .greeting {
      font-size: clamp(2rem, 7vw, 6rem);
      text-align: center;
      text-shadow:
        0 0 8px #00ff41,
        0 0 20px #00ff41,
        0 0 45px #008f11;
    }

    .logout-form {
      margin-left: auto;
    }

    .logout {
      padding: 0.5rem 0.75rem;
      font: inherit;
      cursor: pointer;
    }
  </style>
</head>

<body>
  {{template "header" .}}
  <p id="selected-place" class="selected-place" role="status" hidden></p>

  <main>
    <h1 class="greeting">{{.Greeting}} {{.Username}}</h1>
  </main>

  <script>
    const place = document.getElementById("place");
    const selectedPlace = document.getElementById("selected-place");

    function updateSelectedPlace() {
      selectedPlace.textContent = place.value
        ? place.selectedOptions[0].textContent.trim()
        : "";
      selectedPlace.hidden = !place.value;
    }

    place.addEventListener("change", updateSelectedPlace);
    updateSelectedPlace();
  </script>
</body>
</html>
